<div class="card shadow calculator mt-5" data-controller="calculator" data-calculator-base-price="<%= @vehicle.base_price %>" data-calculator-price-per-km="<%= @vehicle.price_per_km %>">
  <div class="card-body">
    <h3 class="fw-bold mb-4">Calculate Estimated Amount</h3>
    <% if params[:start_date].present? && params[:start_time].present? && params[:end_date].present? && params[:end_time].present? %>
      <h4>Filters</h4>
    <% end %>

    <% [[:start, :start_date, :start_time], [:end, :end_date, :end_time]].each do |prefix, date_param, time_param| %>
      <% if params[date_param].present? && params[time_param].present? %>
        <% parsed_date = Date.parse(params[date_param]) rescue nil %>
        <% parsed_time = Time.parse(params[time_param]) rescue nil %>
        <% if parsed_date && parsed_time %>
          <div class="filter d-flex mt-2">
            <div class="badge bg-primary text-white fs-6">
              <strong><%= prefix.capitalize %> Date & Time:</strong> 
              <%= parsed_date.strftime("%B %d, %Y") %> 
              <%= parsed_time.strftime("%I:%M %p") %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
    <form data-action="submit->calculator#calculate" class="mt-3">
      <input type="hidden" id="startDate" value="<%= params[:start_date] %>" data-calculator-target="startDate">
      <input type="hidden" id="endDate" value="<%= params[:end_date] %>" data-calculator-target="endDate">
      <input type="hidden" id="startTime" value="<%= params[:start_time] %>" data-calculator-target="startTime">
      <input type="hidden" id="endTime" value="<%= params[:end_time] %>" data-calculator-target="endTime">
      
      <div class="form-check form-check-inline">
        <input type="radio" name="trip_type" id="oneWayTrip" value="one_way" checked data-calculator-target="tripType">
        <label for="oneWayTrip" class="form-check-label">One Way</label>
      </div>
      <div class="form-check form-check-inline">
        <input type="radio" name="trip_type" id="twoWayTrip" value="two_way" data-calculator-target="tripType">
        <label for="twoWayTrip" class="form-check-label">Two Way</label>
      </div>

      <div class="form-group mt-3">
        <label for="distanceKm" class="form-label">Kilometers (min. 10)</label>
        <input type="number" id="distanceKm" name="distance_km" class="form-control" min="10" required data-calculator-target="distanceKm">
      </div>

      <div class="mb-3 mt-3">
        <div class="badge bg-primary text-white fs-6"><strong>Base Price:</strong> <%= number_to_currency(@vehicle.base_price, unit: "Rs. ") %></div>
        <div class="badge bg-secondary fs-6 mt-4"><strong>Price Per Km:</strong> <%= number_to_currency(@vehicle.price_per_km, unit: "Rs. ") %></div>
      </div>
      <button type="submit" class="btn btn-primary mt-3">Calculate</button>
    </form>
    <div id="calculatorResult" class="mt-4" data-calculator-target="result"></div>
  </div>
</div>
